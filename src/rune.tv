// rune.tv - Torvik Package Manager, written in Torvik
//
// User commands: new, init, build, run, clean, list/ls, version, help, uninstall.
// Developer commands (unlisted in help): config, dev (config get/set), doctor.
// add / remove / update + [runes] dependencies arrive with the Rune Library (future release).

apply diag;


// ─── Low-level helpers ──────────────────────────────────────────────────────

df rune_is_ws(c: i64) -> i64 {
    check c == 32 || c == 9 || c == 10 || c == 13 { return 1; }
    return 0;
}

df rune_trim(s: str) -> str {
    fixed n: i64 = len(s);
    set a: i64 = 0;
    set done1: i64 = 0;
    whilst done1 == 0 {
        check a >= n { done1 = 1; } fallback {
            check rune_is_ws(byte_at(s, a)) == 1 { a += 1; } fallback { done1 = 1; }
        }
    }
    set b: i64 = n;
    set done2: i64 = 0;
    whilst done2 == 0 {
        check b <= a { done2 = 1; } fallback {
            check rune_is_ws(byte_at(s, b - 1)) == 1 { b -= 1; } fallback { done2 = 1; }
        }
    }
    return substr(s, a, b);
}

df rune_index_of(s: str, ch: str) -> i64 {
    fixed target: i64 = byte_at(ch, 0);
    set i: i64 = 0;
    whilst i < len(s) {
        check byte_at(s, i) == target { return i; }
        i += 1;
    }
    return -1;
}

df rune_strip_quotes(v: str) -> str {
    fixed t: str = rune_trim(v);
    check len(t) >= 2 {
        fixed a: str = substr(t, 0, 1);
        fixed b: str = substr(t, len(t) - 1, len(t));
        check a == "\"" && b == "\"" { return substr(t, 1, len(t) - 1); }
    }
    return t;
}

df rune_path_exists(p: str) -> i64 {
    check fs_exists(p) == 1 { return 1; }
    return 0;
}

df rune_mkdir(p: str) -> void {
    fs_mkdir(p);
}

df rune_str_eq(a: str, b: str) -> i64 {
    fixed la: i64 = len(a);
    fixed lb: i64 = len(b);
    check la != lb { return 0; }
    set i: i64 = 0;
    whilst i < la {
        check byte_at(a, i) != byte_at(b, i) { return 0; }
        i += 1;
    }
    return 1;
}

// ─── Manifest (.rune) field reader ──────────────────────────────────────────

df rune_match_field(line: str, key: str) -> str {
    fixed t: str = rune_trim(line);
    check len(t) > len(key) {
        check starts(t, key) {
            fixed nb: str = substr(t, len(key), len(key) + 1);
            check nb == " " || nb == "=" {
                fixed eq: i64 = rune_index_of(t, "=");
                check eq >= 0 {
                    fixed raw: str = substr(t, eq + 1, len(t));
                    return rune_strip_quotes(rune_trim(raw));
                }
            }
        }
    }
    return "";
}

df rune_field(content: str, key: str) -> str {
    set found: str = "";
    set buf: str = "";
    set i: i64 = 0;
    whilst i < len(content) {
        fixed cc: i64 = byte_at(content, i);
        check cc == 10 {
            check len(found) == 0 {
                fixed v: str = rune_match_field(buf, key);
                check len(v) > 0 { found = v; }
            }
            buf = "";
        } fallback {
            buf = str_concat(buf, substr(content, i, i + 1));
        }
        i += 1;
    }
    check len(found) == 0 {
        fixed v2: str = rune_match_field(buf, key);
        check len(v2) > 0 { found = v2; }
    }
    return found;
}

// ─── Project resolution ─────────────────────────────────────────────────────

// ── Manifest value validation ───────────────────────────────────────────────
// Every value below is read from torvik.rune and interpolated into a shell
// command. A manifest arrives with a repository, so these are attacker-supplied
// the moment someone clones a project and runs `rune build` - the ordinary thing
// a package manager exists to make routine.
//
// They are VALIDATED, not quoted. Shell double-quoting does not stop command
// substitution: "$(...)" still expands. An allowlist is the only reliable answer,
// and nothing legitimate needs a character outside one.
df rune_chars_ok(v: str, extra: str) -> i64 {
    check len(v) == 0 { return 0; }
    set i: i64 = 0;
    whilst i < len(v) {
        fixed c: i64 = byte_at(v, i);
        set ok: i64 = 0;
        check c >= 97 && c <= 122 { ok = 1; }
        check c >= 65 && c <= 90  { ok = 1; }
        check c >= 48 && c <= 57  { ok = 1; }
        set j: i64 = 0;
        whilst j < len(extra) {
            check byte_at(extra, j) == c { ok = 1; }
            j += 1;
        }
        check ok == 0 { return 0; }
        i += 1;
    }
    return 1;
}

// A path may hold separators, spaces and colons, so it is screened for shell
// metacharacters rather than restricted to an allowlist.
df rune_path_field_ok(v: str) -> i64 {
    check len(v) == 0 { return 0; }
    set i: i64 = 0;
    whilst i < len(v) {
        fixed c: i64 = byte_at(v, i);
        check c == 36 || c == 96 || c == 34 || c == 39 { return 0; }
        check c == 59 || c == 124 || c == 38 || c == 92 { return 0; }
        check c == 60 || c == 62 || c == 40 || c == 41 { return 0; }
        check c == 10 || c == 13 { return 0; }
        i += 1;
    }
    return 1;
}

df rune_reject_field(field: str, value: str, whatfor: str) -> void {
    echo!(fmt("rune: the '{}' value in torvik.rune is not usable.", field));
    echo!(fmt("  value: {}", value));
    echo!(fmt("  {}", whatfor));
    echo!("  A manifest travels with a repository, so this value is refused rather");
    echo!("  than passed to a shell.");
    exit(1);
}

df rune_get_name() -> str {
    // No manifest at all (a bare src/main.tv build): fall back to the directory
    // name, which is more meaningful than a generic "output".
    check rune_path_exists("torvik.rune") == 0 { return rune_cwd_name(); }
    fixed content: str = readfile("torvik.rune");
    fixed n: str = rune_field(content, "name");
    check len(n) > 0 {
        check rune_chars_ok(n, "_-.") == 0 {
            rune_reject_field("name", n, "The name becomes the output file path, so it is limited to letters, digits, and _ - . characters.");
        }
        return n;
    }
    // A manifest that exists but has no name is malformed - surface it rather than
    // silently building something called "output".
    echo!("error: torvik.rune is missing a 'name' field.");
    echo!("  add a line like:  name = \"myapp\"");
    exit(1);
    return "output";
}

df rune_get_entry() -> str {
    check rune_path_exists("src/main.tv") == 1 { return "src/main.tv"; }
    return "";
}

// The compiled binary's extension and how it's invoked differ by platform. On
// Windows executables end in .exe and are run by bare path (no "./" prefix);
// POSIX has no extension and runs a relative path via "./".
df rune_exe_ext() -> str {
    check rune_str_eq(sys_os_name(), "windows") == 1 { return ".exe"; }
    return "";
}

df rune_run_prefix() -> str {
    check rune_str_eq(sys_os_name(), "windows") == 1 { return ""; }
    return "./";
}

// Human-readable form of the Torvik install directory for messages/help. Windows
// users see %USERPROFILE%\.torvik; everyone else sees ~/.torvik. (The actual
// filesystem path is always sys_home_dir()/.torvik; this is display only.)
df rune_home_display() -> str {
    check rune_str_eq(sys_os_name(), "windows") == 1 { return "%USERPROFILE%\\.torvik"; }
    return "~/.torvik";
}

// Build the command used to execute a compiled binary. On Windows, cmd.exe reads
// a forward slash as the start of a switch, so `build/test.exe` is parsed as the
// command `build` with a `/test.exe` flag ("'build' is not recognized"). Convert
// the separators to backslashes and prefix with `.\` so it's unambiguously a path.
// On POSIX, prefix with `./` as usual.
df rune_run_path(out: str) -> str {
    check rune_str_eq(sys_os_name(), "windows") == 1 {
        fixed bs: str = replace(out, "/", "\\");
        return str_concat(".\\", bs);
    }
    return str_concat("./", out);
}

df rune_find_torvc() -> str {
    fixed local: str = str_concat(str_concat(sys_home_dir(), "/.torvik/bin/torvc"), rune_exe_ext());
    check rune_path_exists(local) == 1 { return local; }
    return "torvc";
}

df rune_has_final() -> i64 {
    fixed argc: i64 = args();
    set i: i64 = 2;
    whilst i < argc {
        fixed a: str = args_get(i);
        check a == "--final" { return 1; }
        i += 1;
    }
    return 0;
}

df rune_has_yes() -> i64 {
    fixed argc: i64 = args();
    set i: i64 = 2;
    whilst i < argc {
        fixed a: str = args_get(i);
        check a == "--yes" { return 1; }
        i += 1;
    }
    return 0;
}

// True if --force appears among the arguments. Used by `rune update` to reinstall
// even when the toolchain is already at the latest version.
df rune_has_force() -> i64 {
    fixed argc: i64 = args();
    set i: i64 = 2;
    whilst i < argc {
        fixed a: str = args_get(i);
        check a == "--force" { return 1; }
        i += 1;
    }
    return 0;
}

// v1.5.0 major-version-gating flags.
df rune_has_flag(name: str) -> i64 {
    fixed argc: i64 = args();
    set i: i64 = 2;
    whilst i < argc {
        check rune_str_eq(args_get(i), name) == 1 { return 1; }
        i += 1;
    }
    return 0;
}
df rune_has_silence_major() -> i64 { return rune_has_flag("--silence-major"); }
df rune_has_silence_std_major() -> i64 { return rune_has_flag("--silence-std-major"); }
df rune_has_std_major() -> i64 { return rune_has_flag("--std-major"); }

df rune_cwd_name() -> str {
    fixed full: str = cwd();
    fixed n: i64 = len(full);
    check n == 0 { return "project"; }
    set cut: i64 = 0;
    set i: i64 = 0;
    whilst i < n {
        check byte_at(full, i) == 47 { cut = i + 1; }
        i += 1;
    }
    return substr(full, cut, n);
}

// ─── Templates ──────────────────────────────────────────────────────────────

df rune_manifest(name: str) -> str {
    set m: str = "[project]\nname        = \"";
    m = str_concat(m, name);
    m = str_concat(m, "\"\nversion     = \"0.1.0\"\ndescription = \"\"\nauthor      = \"\"\n");
    // Record the Torvik version this project was created with as its minimum
    // requirement. `rune build`/`run` refuses to build with an older toolchain
    // and tells the user how to update. Remove or lower the line to relax it.
    // (Skipped if the installed version can't be determined.)
    fixed tv: str = rune_ver_of("torvik");
    check rune_str_eq(tv, "0.0.0") == 0 {
        m = str_concat(m, str_concat(str_concat("torvik      = \"", tv), "\"\n"));
    }
    m = str_concat(m, "\n[runes]\n# Dependencies (coming with the Rune Library; not yet supported)\n");
    return m;
}

df rune_main_src(name: str) -> str {
    set s: str = "// apply std;   // uncomment for the standard library (math, strings, list)\n\ndf main() -> void {\n    echo!(\"Hello from ";
    s = str_concat(s, name);
    s = str_concat(s, "!\");\n}\n");
    return s;
}

// ─── User commands ──────────────────────────────────────────────────────────

df rune_cmd_new(name: str) -> void {
    check len(name) == 0 {
        echo!("error: project name can't be empty");
        exit(1);
    }
    check rune_index_of(name, "/") >= 0 {
        echo!(str_concat(str_concat("error: project name '", name), "' can't contain '/' - use a plain name like 'myapp'"));
        exit(1);
    }
    check rune_path_exists(name) == 1 {
        echo!(str_concat(str_concat("error: directory '", name), "' already exists"));
        exit(1);
    }
    rune_mkdir(str_concat(name, "/src"));
    rune_mkdir(str_concat(name, "/lib"));
    writefile(str_concat(name, "/torvik.rune"), rune_manifest(name));
    writefile(str_concat(name, "/src/main.tv"), rune_main_src(name));
    writefile(str_concat(name, "/.gitignore"), "build/\n*.ll\n*.o\n");
    echo!(str_concat(str_concat("Created project '", name), "'"));
    echo!(str_concat("  cd ", name));
    echo!("  rune run");
}

df rune_cmd_init(name: str) -> void {
    check rune_path_exists("torvik.rune") == 1 {
        echo!("error: already a Torvik project (torvik.rune exists here).");
        exit(1);
    }
    rune_mkdir("src");
    rune_mkdir("lib");
    writefile("torvik.rune", rune_manifest(name));
    check rune_path_exists("src/main.tv") == 0 {
        writefile("src/main.tv", rune_main_src(name));
    }
    check rune_path_exists(".gitignore") == 0 {
        writefile(".gitignore", "build/\n*.ll\n*.o\n");
    }
    echo!(str_concat(str_concat("Initialized Torvik project '", name), "' in the current directory."));
    echo!("  rune run");
}

// Resolve the project entry source, or print a precise error and exit. Distinguishes
// "this is a configured project but its src/main.tv is missing" from "no project here".
df rune_require_entry() -> str {
    fixed entry: str = rune_get_entry();
    check len(entry) > 0 { return entry; }
    check rune_path_exists("torvik.rune") == 1 {
        echo!("error: this Torvik project is missing its entry source (expected src/main.tv).");
        echo!("  create src/main.tv containing a 'main' function.");
        exit(1);
    }
    echo!("error: not a Torvik project (no torvik.rune or src/main.tv here).");
    echo!("  run 'rune new <name>' to create one.");
    exit(1);
    return "";
}

// ── v1.5.0: the [build] manifest section ─────────────────────────────────────
// Systems and OS work needs a pile of build settings that shouldn't have to be
// retyped on every command. Declaring them once in torvik.rune means `rune build`
// and `rune run` do the right thing for a kernel exactly as they do for a program.
//
//   [build]
//   target = bare                          # bare | native (default native)
//   entry = kernel_main                    # symbol torvc emits (default _start)
//   arch = x86_64-unknown-none-elf         # target triple
//   link-script = linker.ld
//   link-with = boot.s
//   elf32 = true                           # 32-bit ELF container (Multiboot 1)
//   runner = qemu-system-x86_64 -kernel {output}
//
// {output} in `runner` is replaced by the built image path.
df rune_build_field(key: str) -> str {
    check rune_path_exists("torvik.rune") == 0 { return ""; }
    return rune_field(readfile("torvik.rune"), key);
}

df rune_is_bare_project() -> i64 {
    fixed t: str = rune_build_field("target");
    check rune_str_eq(t, "bare") == 1 { return 1; }
    return 0;
}

// The extra torvc flags implied by [build]. Empty for an ordinary project.
df rune_build_flags() -> str {
    set f: str = "";
    check rune_is_bare_project() == 1 { f = str_concat(f, " --bare"); } fallback {
        check rune_str_eq(rune_build_field("no-std"), "true") == 1 { f = str_concat(f, " --no-std"); }
    }
    fixed e: str = rune_build_field("entry");
    check len(e) > 0 {
        check rune_chars_ok(e, "_") == 0 {
            rune_reject_field("entry", e, "The entry symbol is emitted into LLVM IR, so it follows C identifier rules: letters, digits and underscores.");
        }
        f = str_concat(f, str_concat(" --entry ", e));
    }
    fixed a: str = rune_build_field("arch");
    check len(a) > 0 {
        check rune_chars_ok(a, "_-.") == 0 {
            rune_reject_field("arch", a, "The target triple is passed to clang as `-target <triple>`, so it is limited to letters, digits, and _ - . characters.");
        }
        f = str_concat(f, str_concat(" --arch ", a));
    }
    fixed ls: str = rune_build_field("link-script");
    check len(ls) > 0 {
        check rune_path_field_ok(ls) == 0 {
            rune_reject_field("link-script", ls, "A path here must not contain shell metacharacters.");
        }
        check rune_path_exists(ls) == 0 {
            echo!(fmt("rune: link-script '{}' is named in torvik.rune but doesn't exist.", ls));
            exit(1);
        }
        f = str_concat(f, str_concat(" --link-script ", ls));
    }
    // Multiboot 1 loaders refuse a 64-bit ELF, so a bootable kernel needs the image
    // rewritten as a 32-bit container. Off by default: a bare image that is not
    // multiboot (an EFI payload, a custom loader) has no use for it.
    check rune_str_eq(rune_build_field("elf32"), "true") == 1 { f = str_concat(f, " --elf32"); }
    fixed lw: str = rune_build_field("link-with");
    check len(lw) > 0 {
        check rune_path_field_ok(lw) == 0 {
            rune_reject_field("link-with", lw, "A path here must not contain shell metacharacters.");
        }
        check rune_path_exists(lw) == 0 {
            echo!(fmt("rune: link-with '{}' is named in torvik.rune but doesn't exist.", lw));
            exit(1);
        }
        f = str_concat(f, str_concat(" --link-with ", lw));
    }
    return f;
}

// Substitute {output} in the runner command.
df rune_runner_cmd(out: str) -> str {
    fixed r: str = rune_build_field("runner");
    check len(r) == 0 { return ""; }
    set res: str = "";
    set i: i64 = 0;
    whilst i < len(r) {
        check i + 8 <= len(r) {
            check rune_str_eq(substr(r, i, i + 8), "{output}") == 1 {
                res = str_concat(res, out);
                i += 8;
                continue;
            }
        }
        res = str_concat(res, substr(r, i, i + 1));
        i += 1;
    }
    return res;
}

df rune_cmd_build(final: i64) -> void {
    fixed entry: str = rune_require_entry();
    rune_check_project_version();
    rune_check_std_version();
    fixed t_start: i64 = time_ms();
    fixed name: str = rune_get_name();
    rune_mkdir("build");
    // A freestanding image is not an executable for this host, so it gets a .elf
    // extension rather than the host's (nothing, or .exe) - calling it `myproject.exe`
    // when it is a kernel would be actively misleading.
    set out: str = str_concat(str_concat("build/", name), rune_exe_ext());
    check rune_is_bare_project() == 1 { out = str_concat(str_concat("build/", name), ".elf"); }
    fixed torvc: str = rune_find_torvc();
    set cmd: str = str_concat(str_concat(str_concat(str_concat(torvc, " "), entry), " -o "), out);
    cmd = str_concat(cmd, " -q");
    cmd = str_concat(cmd, rune_build_flags());
    check final == 1 { cmd = str_concat(cmd, " --final"); }
    cmd = str_concat(cmd, str_concat(str_concat(" > ", rune_diag_log()), " 2>&1"));
    fixed rc: i64 = sys_run(cmd);
    rune_echo_diag();
    check rc == 0 {
        check diag_path_exists(out) == 1 {
            echo!(fmt("Compiled {} in {}", out, diag_fmt_secs(time_ms() - t_start)));
        } fallback {
            internal_error("RUNE-3001", "build", entry, "torvc reported success but produced no output binary");
        }
    } fallback {
        exit(rc);
    }
}

// v1.3.0: warnings must survive the build cache. torvc's diagnostics are
// captured to build/.diag.log during a real compile and REPLAYED on cache
// hits - so `rune run` shows the same warnings every time until the code is
// fixed or a suppressor (--no-warn / !@ directives) is used, both of which
// leave the log empty naturally. Errors ride the same capture (echoed before
// the failing exit).
df rune_diag_log() -> str { return "build/.diag.log"; }

df rune_echo_diag() -> void {
    check rune_path_exists(rune_diag_log()) == 0 { return; }
    fixed d: str = readfile(rune_diag_log());
    check len(trim(d)) > 0 { echo(d); }
}

df rune_needs_rebuild(out: str, srcpath: str) -> i64 {
    check rune_path_exists(out) == 0 { return 1; }
    fixed st: i64 = fs_mtime(srcpath);
    fixed ot: i64 = fs_mtime(out);
    check st > ot { return 1; }
    return 0;
}

df rune_cmd_run(final: i64) -> void {
    // v1.5.0: `rune run <file.tv> [args...]` runs an individual file directly
    // (python3-style), forwarding any following tokens to the program. A bare
    // `rune run` still builds and runs the project (src/main.tv). The first .tv
    // token after `run` is the script; everything after it is forwarded verbatim.
    fixed argc: i64 = args();
    set file_idx: i64 = 0;
    set fi: i64 = 2;
    whilst fi < argc && file_idx == 0 {
        check ends(args_get(fi), ".tv") { file_idx = fi; }
        fi += 1;
    }
    check file_idx > 0 {
        fixed script: str = args_get(file_idx);
        check rune_path_exists(script) == 0 {
            echo!(str_concat(str_concat("rune: cannot open '", script), "' - no such file"));
            exit(1);
        }
        // Delegate to torvc's run mode (compile + execute + forward args + cleanup).
        fixed torvc: str = rune_find_torvc();
        set cmd: str = str_concat(str_concat("\"", torvc), str_concat("\" \"", str_concat(script, "\"")));
        set k: i64 = file_idx + 1;
        whilst k < argc {
            cmd = str_concat(cmd, str_concat(" \"", str_concat(args_get(k), "\"")));
            k += 1;
        }
        // Windows: sys_run goes through `cmd /c`, which strips the outermost pair of
        // quotes from a command that both begins and ends with one. That mangles
        //     "torvc.exe" "prog.tv"
        // into an unrunnable line, while a command with a third quoted token happened
        // to survive - which is exactly the shape of the failure we saw. Wrapping the
        // whole thing in one more pair gives cmd a pair to eat and leaves ours intact.
        set runcmd: str = cmd;
        check rune_str_eq(sys_os_name(), "windows") == 1 {
            runcmd = str_concat(str_concat("\"", cmd), "\"");
        }
        fixed frc: i64 = sys_run(runcmd);
        exit(frc);
    }
    // v1.5.0: a bare project cannot be executed by this host - it is a kernel, not a
    // program. If [build] names a runner, hand the image to it (QEMU, typically);
    // if not, say so plainly rather than trying to exec an ELF the OS will refuse.
    check rune_is_bare_project() == 1 {
        rune_cmd_build(final);
        fixed bname: str = str_concat(str_concat("build/", rune_get_name()), ".elf");
        fixed runner: str = rune_runner_cmd(bname);
        check len(runner) == 0 {
            echo!(fmt("Built {}.", bname));
            echo!("  This is a freestanding image, so there is nothing on this machine to run it.");
            echo!("  Add a runner to torvik.rune to launch it:");
            echo!("");
            echo!("    [build]");
            echo!("    runner = qemu-system-x86_64 -kernel {{output}}");
            exit(0);
        }
        echo!(str_concat("Running: ", runner));
        fixed rrc: i64 = sys_run(runner);
        exit(rrc);
    }
    fixed entry: str = rune_require_entry();
    rune_check_project_version();
    rune_check_std_version();
    fixed name: str = rune_get_name();
    rune_mkdir("build");
    fixed out: str = str_concat(str_concat("build/", name), rune_exe_ext());
    fixed torvc: str = rune_find_torvc();
    set stale: i64 = rune_needs_rebuild(out, entry);
    check rune_str_eq(rune_config_get("cache"), "false") == 1 { stale = 1; }
    check stale == 1 || final == 1 {
        set cmd: str = str_concat(str_concat(str_concat(str_concat(torvc, " "), entry), " -o "), out);
        cmd = str_concat(cmd, " -q");
        check final == 1 { cmd = str_concat(cmd, " --final"); }
        cmd = str_concat(cmd, str_concat(str_concat(" > ", rune_diag_log()), " 2>&1"));
        fixed rc: i64 = sys_run(cmd);
        rune_echo_diag();
        check rc != 0 { exit(rc); }
    } fallback {
        // cache hit: no compile ran - replay the last build's diagnostics so
        // warnings stay visible on every run until resolved or suppressed.
        rune_echo_diag();
    }
    fixed prc: i64 = sys_run(rune_run_path(out));
    exit(prc);
}

df rune_cmd_clean() -> void {
    check rune_path_exists("build") == 1 {
        fs_remove("build");
        echo!("Cleaned build/");
    } fallback {
        echo!("Nothing to clean.");
    }
}

df rune_cmd_list() -> void {
    check rune_path_exists("torvik.rune") == 0 {
        echo!("error: not a Torvik project (no torvik.rune here).");
        echo!("  run 'rune init' or 'rune new <name>' to create one.");
        exit(1);
    }
    fixed content: str = readfile("torvik.rune");
    echo!(str_concat("Project: ", rune_field(content, "name")));
    fixed ver: str = rune_field(content, "version");
    check len(ver) > 0 { echo!(str_concat("Version: ", ver)); }
    fixed desc: str = rune_field(content, "description");
    check len(desc) > 0 { echo!(str_concat("Description: ", desc)); }
    fixed auth: str = rune_field(content, "author");
    check len(auth) > 0 { echo!(str_concat("Author:  ", auth)); }
    echo!("");
    echo!("Dependencies arrive with the Rune Library - a future version of Torvik.");
    echo!("(The registry needs real infrastructure to run, so its timeline will be");
    echo!("announced separately. Follow the roadmap on GitHub for updates.)");
}

// Remove the Torvik PATH entry from one shell startup file: the line adding
// ~/.torvik/bin to PATH, the "# Torvik" marker comment above it, and the blank
// line the installer inserted before the marker. Rewrites the file only when
// something was actually removed. Returns 1 if the file was modified.
df rune_strip_path_entry(path: str) -> i64 {
    check rune_path_exists(path) == 0 { return 0; }
    fixed content: str = readfile(path);
    check len(content) == 0 { return 0; }
    fixed lines: list<str> = split(content, "\n");
    set kept: list<str> = list_new();
    set removed: i64 = 0;
    set i: i64 = 0;
    whilst i < len(lines) {
        fixed ln: str = lines[i];
        fixed t: str = rune_trim(ln);
        set drop: i64 = 0;
        check contains(t, ".torvik/bin") { drop = 1; }
        check rune_str_eq(t, "# Torvik") == 1 {
            drop = 1;
            // The installer wrote "\n# Torvik\n<PATH line>" - collapse the blank
            // line it left above the marker so no gap remains.
            fixed nk: i64 = len(kept);
            check nk > 0 {
                check len(rune_trim(kept[nk - 1])) == 0 { list_remove(kept, nk - 1); }
            }
        }
        check drop == 1 { removed = 1; } fallback { push(kept, ln); }
        i += 1;
    }
    check removed == 0 { return 0; }
    // split("a\nb\n") yields a trailing "" element, so joining with "\n"
    // round-trips the file byte-for-byte (including its final newline).
    set out: str = "";
    set j: i64 = 0;
    whilst j < len(kept) {
        check j > 0 { out = str_concat(out, "\n"); }
        out = str_concat(out, kept[j]);
        j += 1;
    }
    writefile(path, out);
    return 1;
}

// Strip the Torvik PATH entry from every shell startup file the installer may
// have written to. Checks all candidates (not just $SHELL's) so an uninstall
// cleans up even after the user switched shells since installing.
df rune_clean_path_entries() -> void {
    fixed home: str = sys_home_dir();
    check rune_strip_path_entry(str_concat(home, "/.bashrc")) == 1 {
        echo!("Removed the Torvik PATH entry from ~/.bashrc");
    }
    check rune_strip_path_entry(str_concat(home, "/.profile")) == 1 {
        echo!("Removed the Torvik PATH entry from ~/.profile");
    }
    check rune_strip_path_entry(str_concat(home, "/.zshrc")) == 1 {
        echo!("Removed the Torvik PATH entry from ~/.zshrc");
    }
    check rune_strip_path_entry(str_concat(home, "/.config/fish/config.fish")) == 1 {
        echo!("Removed the Torvik PATH entry from ~/.config/fish/config.fish");
    }
}

// Deregister the .tv file type and icons the installer registered (Linux,
// freedesktop). Uses the canonical xdg tools when present, removes the manually
// copied files otherwise, then refreshes the caches. Every step is best-effort:
// on systems without these tools (or where nothing was registered) each command
// simply no-ops, so this is safe to run unconditionally.
df rune_data_dir() -> str {
    fixed xdg: str = readenv("XDG_DATA_HOME");
    check len(xdg) > 0 { return xdg; }
    return str_concat(sys_home_dir(), "/.local/share");
}

df rune_deregister_icons() -> void {
    // Desktop integration: freedesktop (xdg-mime, hicolor icons) on Linux;
    // per-user registry keys (HKCU\Software\Classes) on Windows, matching what
    // install.ps1 registers (v1.2.0). macOS is a no-op.
    check rune_str_eq(sys_os_name(), "windows") == 1 {
        sys_run("reg delete \"HKCU\\Software\\Classes\\.tv\" /f > NUL 2>&1");
        sys_run("reg delete \"HKCU\\Software\\Classes\\Torvik.Source\" /f > NUL 2>&1");
        sys_run("reg delete \"HKCU\\Software\\Classes\\SystemFileAssociations\\.tv\" /f > NUL 2>&1");
        return;
    }
    check rune_str_eq(sys_os_name(), "linux") == 0 { return; }
    fixed data: str = rune_data_dir();
    sys_run(fmt("xdg-mime uninstall --mode user \"{}/mime/packages/torvik-mime.xml\" > /dev/null 2>&1", data));
    sys_run(fmt("rm -f \"{}/mime/packages/torvik-mime.xml\" > /dev/null 2>&1", data));
    set sizes: list<str> = list_new();
    push(sizes, "16"); push(sizes, "32"); push(sizes, "48");
    push(sizes, "64"); push(sizes, "128"); push(sizes, "256");
    set i: i64 = 0;
    whilst i < len(sizes) {
        fixed s: str = sizes[i];
        sys_run(fmt("xdg-icon-resource uninstall --mode user --noupdate --context mimetypes --size {} text-x-torvik > /dev/null 2>&1", s));
        sys_run(fmt("xdg-icon-resource uninstall --mode user --noupdate --context apps --size {} torvik > /dev/null 2>&1", s));
        sys_run(fmt("rm -f \"{}/icons/hicolor/{}x{}/mimetypes/text-x-torvik.png\" > /dev/null 2>&1", data, s, s));
        sys_run(fmt("rm -f \"{}/icons/hicolor/{}x{}/apps/torvik.png\" > /dev/null 2>&1", data, s, s));
        i += 1;
    }
    sys_run("xdg-icon-resource forceupdate --mode user > /dev/null 2>&1");
    sys_run(fmt("command -v update-mime-database > /dev/null 2>&1 && update-mime-database \"{}/mime\" > /dev/null 2>&1", data));
    sys_run(fmt("command -v gtk-update-icon-cache > /dev/null 2>&1 && gtk-update-icon-cache -f \"{}/icons/hicolor\" > /dev/null 2>&1", data));
}

// ─── Toolchain self-update ──────────────────────────────────────────────────
// `rune update` refreshes the Torvik TOOLCHAIN in place by re-running the
// official installer for the current platform, which fetches the latest release
// from GitHub and reinstalls torvc/rune/lib. (This is distinct from dependency
// management - `rune add`/`remove` for project libraries - which arrives with
// the Rune Library in a future version.) Requires a network fetch tool: curl or
// wget on POSIX, PowerShell on Windows.
// Return the version argument to `rune update`, if any - the first non-flag
// token after the command (e.g. "v1.0.1" in `rune update v1.0.1`). Returns ""
// when the user typed a bare `rune update`. Flags like --yes are skipped.
df rune_update_version_arg() -> str {
    fixed argc: i64 = args();
    set i: i64 = 2;
    whilst i < argc {
        fixed a: str = args_get(i);
        check starts(a, "--") { } fallback {
            // args_get returns a borrowed OS-argv string; copy it into a proper
            // headered string (via concat) before it flows through further calls.
            return str_concat(a, "");
        }
        i += 1;
    }
    return "";
}

// Validate a toolchain version string. Accepts an optional leading 'v' and one,
// two, or three dot-separated numeric components: v1, v1.0, v1.0.0, 1.1.0, etc.
// Returns 1 if well-formed, 0 otherwise. (Resolution of a PARTIAL version like
// v1 or v1.0 to a concrete release happens in the installer, which can see the
// GitHub release list; rune only checks the SYNTAX here.)
df rune_version_syntax_ok(v: str) -> i64 {
    set s: str = v;
    check starts(s, "v") || starts(s, "V") { s = substr(s, 1, len(s)); }
    fixed n: i64 = len(s);
    check n == 0 { return 0; }
    set i: i64 = 0;
    set parts: i64 = 1;
    set digits_in_part: i64 = 0;
    whilst i < n {
        fixed c: i64 = byte_at(s, i);
        check c == 46 {
            // a dot: the previous part must have had at least one digit
            check digits_in_part == 0 { return 0; }
            parts += 1;
            digits_in_part = 0;
        } fallback {
            check c >= 48 && c <= 57 { digits_in_part += 1; } fallback { return 0; }
        }
        i += 1;
    }
    // trailing part must have digits, and at most three parts (major.minor.patch)
    check digits_in_part == 0 { return 0; }
    check parts > 3 { return 0; }
    return 1;
}

// Normalize to a canonical "vX[.Y[.Z]]" form for passing to the installer and
// for display (always exactly one leading 'v', digits and dots preserved).
df rune_version_canon(v: str) -> str {
    set s: str = v;
    check starts(s, "v") || starts(s, "V") { s = substr(s, 1, len(s)); }
    return str_concat("v", s);
}

// Fetch a `key = value` field from a VERSION file on a GitHub main branch.
// Returns the value (e.g. "1.4.0"), or "" if the fetch fails (offline, no
// curl/wget). Writes to a temp file and reads it back, since rune shells out
// rather than capturing stdout directly.
df rune_fetch_remote_field(url: str, key: str, tmpname: str) -> str {
    fixed cache: str = str_concat(sys_home_dir(), "/.torvik/cache");
    rune_mkdir(cache);
    fixed tmp: str = str_concat(cache, str_concat("/", tmpname));
    fixed win: i64 = rune_str_eq(sys_os_name(), "windows");
    set rc: i64 = 1;
    check win == 1 {
        fixed ps: str = str_concat(str_concat("powershell -NoProfile -Command \"(iwr -useb ", url), str_concat(").Content | Out-File -Encoding ascii '", str_concat(tmp, "'\"")));
        rc = sys_run(ps);
    } fallback {
        check rune_on_path("curl") == 1 {
            rc = sys_run(str_concat(str_concat("curl -fsSL ", url), str_concat(" -o ", tmp)));
        } fallback {
            check rune_on_path("wget") == 1 {
                rc = sys_run(str_concat(str_concat("wget -qO ", tmp), str_concat(" ", url)));
            }
        }
    }
    check rc != 0 { return ""; }
    check fs_exists(tmp) == 0 { return ""; }
    return rune_field(readfile(tmp), key);
}

// The latest published Torvik version (torvik key, from the Torvik repo).
df rune_fetch_latest_version() -> str {
    return rune_fetch_remote_field("https://raw.githubusercontent.com/torvik-lang/torvik/main/VERSION", "torvik", "latest_version.txt");
}

// The latest published rune version (rune key, from the separate rune repo).
df rune_fetch_latest_rune() -> str {
    return rune_fetch_remote_field("https://raw.githubusercontent.com/torvik-lang/rune/main/VERSION", "rune", "latest_rune.txt");
}

// Run rune's OWN installer from the torvik-lang/rune repo (updates just the
// package manager). Mirrors the toolchain updater but points at the rune repo.
// Returns the installer's exit code (0 on success).
df rune_run_rune_installer() -> i64 {
    fixed win: i64 = rune_str_eq(sys_os_name(), "windows");
    check win == 1 {
        fixed guarded: str = "try { $s = (iwr -useb 'https://raw.githubusercontent.com/torvik-lang/rune/main/windows/install.ps1').Content } catch { Write-Host 'error: could not download the rune installer (network or GitHub error). Try again shortly.' -ForegroundColor Red; exit 1 }; Invoke-Expression $s";
        fixed pscmd: str = str_concat(str_concat("powershell -NoProfile -ExecutionPolicy Bypass -Command \"", guarded), "\"");
        return sys_run(pscmd);
    }
    fixed lurl: str = "https://raw.githubusercontent.com/torvik-lang/rune/main/linux/install.sh";
    check rune_on_path("curl") == 1 {
        return sys_run(str_concat(str_concat("sh -c 'curl -fsSL ", lurl), " | sh'"));
    }
    check rune_on_path("wget") == 1 {
        return sys_run(str_concat(str_concat("sh -c 'wget -qO- ", lurl), " | sh'"));
    }
    echo!("rune self-update needs curl or wget. Install one and retry.");
    return 1;
}

df rune_cmd_update(confirmed: i64, pin_in: str) -> void {
    // Copy the incoming version into a fresh headered string immediately: it may
    // originate from a borrowed OS-argv pointer, and it flows through several
    // helpers (syntax check, canonicalization) plus fmt below.
    fixed pin: str = str_concat(pin_in, "");
    fixed pinned: i64 = len(pin) > 0;
    // Validate the requested version's SYNTAX up front, before any prompt or
    // network call, so a typo like `rune update v1.x` fails fast and clearly.
    check pinned == 1 {
        check rune_version_syntax_ok(pin) == 0 {
            echo!(fmt("rune: '{}' is not a valid version.", pin));
            echo!("  Use a version like v1, v1.0, v1.1.0 - or run 'rune update' for the latest.");
            exit(1);
        }
    }
    fixed win: i64 = rune_str_eq(sys_os_name(), "windows");
    fixed forced: i64 = rune_has_force();
    fixed installed: str = rune_ver_of("torvik");

    // ── v1.5.0: standard-library gating ──────────────────────────────────────
    // std versions independently of the compiler now, so `rune update` treats it
    // the same way it treats Torvik: stay inside the current major, surface a new
    // one, never cross without being told to. Two ways to opt in - pin it in the
    // manifest, or `rune update --std-major --yes`. The manifest wins either way.
    fixed std_have: str = rune_std_installed();
    fixed std_latest: str = rune_fetch_latest_std();
    set std_pin: str = "";
    check rune_path_exists("torvik.rune") == 1 { std_pin = rune_field(readfile("torvik.rune"), "std"); }

    check rune_has_std_major() == 1 {
        check len(std_latest) == 0 {
            echo!("rune: couldn't reach the standard library repository to check for a new major.");
            exit(1);
        }
        fixed sh_major: i64 = rune_ver_part(std_have, 0);
        fixed sl_major: i64 = rune_ver_part(std_latest, 0);
        check sl_major <= sh_major {
            echo!(fmt("The standard library is already on its newest major (v{}).", std_have));
            exit(0);
        }
        check confirmed == 0 {
            echo!(fmt("Standard library v{} is available - a NEW MAJOR (you have v{}).", std_latest, std_have));
            echo!("  A major version may change or remove things your code depends on.");
            echo!("  This only checks; nothing has been installed.");
            echo!("  To go ahead:  rune update --std-major --yes");
            check len(std_pin) > 0 {
                echo!(fmt("  Note: torvik.rune pins std = {} - that pin will be rewritten to {}.", std_pin, std_latest));
            }
            exit(0);
        }
        check rune_sync_std(std_latest) != 0 { exit(1); }
        rune_manifest_set_std(std_latest);
        rune_notice_set("std_major", sl_major);
        exit(0);
    }

    // Same for the Torvik-side flag. Without this it silently did nothing whenever
    // there was no new major - indistinguishable from success.
    check rune_has_silence_major() == 1 {
        fixed tvl: str = rune_fetch_latest_version();
        check len(tvl) == 0 {
            echo!("rune: couldn't reach the Torvik repository, so there's nothing to silence yet.");
            echo!("  Try again when you're online.");
            exit(1);
        }
        check rune_ver_part(tvl, 0) <= rune_ver_part(installed, 0) {
            echo!(fmt("There's no new Torvik major to silence - v{} is the newest, and you're on v{}.", tvl, installed));
            echo!("  Run this again if a major version ships and you'd rather not be told twice.");
            exit(0);
        }
    }

    // Silencing is only meaningful when there is something to silence. Recording an
    // acknowledgement for a major that hasn't shipped would look like it worked while
    // doing nothing the user could observe - so say plainly which case this is.
    check rune_has_silence_std_major() == 1 {
        check len(std_latest) == 0 {
            echo!("rune: couldn't reach the standard library repository, so there's nothing to silence yet.");
            echo!("  Try again when you're online.");
            exit(1);
        }
        fixed sil_have: i64 = rune_ver_part(std_have, 0);
        fixed sil_new: i64 = rune_ver_part(std_latest, 0);
        check sil_new <= sil_have {
            echo!(fmt("There's no new standard-library major to silence - v{} is the newest, and you're on v{}.", std_latest, std_have));
            echo!("  Run this again if a major version ships and you'd rather not be told twice.");
            exit(0);
        }
        check rune_notice_get("std_major") >= sil_new {
            echo!(fmt("Standard library v{} was already silenced. You'll hear about the next major, not this one.", std_latest));
            exit(0);
        }
        rune_notice_set("std_major", sil_new);
        echo!(fmt("Silenced: no more notices about standard library v{}.", std_latest));
        echo!(fmt("  You'll be told again when {}.0.0 ships.", int_to_str(sil_new + 1)));
        exit(0);
    }

    // A manifest pin is an explicit instruction, including across a major - it is the
    // project stating what it needs, which outranks the safety default.
    check len(std_pin) > 0 {
        check rune_ver_ge(std_have, std_pin) == 0 {
            echo!(fmt("torvik.rune asks for standard library {} (v{} installed) - fetching it.", std_pin, std_have));
            check rune_sync_std(std_pin) != 0 { exit(1); }
        }
    } fallback {
        // No pin: keep to the current std major, and surface a new one once.
        check len(std_latest) > 0 {
            fixed sh2: i64 = rune_ver_part(std_have, 0);
            fixed sl2: i64 = rune_ver_part(std_latest, 0);
            check sl2 > sh2 {
                check rune_has_silence_std_major() == 0 {
                    check rune_notice_get("std_major") < sl2 {
                        echo!(fmt("Heads up: standard library v{} is available - a NEW MAJOR (you're on v{}).", std_latest, std_have));
                        echo!(fmt("  Staying on {}.x, since a major version can break existing code.", int_to_str(sh2)));
                        echo!("  To move up, either pin it in torvik.rune:");
                        echo!(fmt("      std = {}", std_latest));
                        echo!("  or run:  rune update --std-major --yes");
                        echo!("  Silence this notice:  rune update --silence-std-major");
                    }
                }
                fixed std_in_major: str = rune_fetch_latest_std_in_major(sh2);
                check len(std_in_major) > 0 {
                    check rune_ver_ge(std_have, std_in_major) == 0 {
                        echo!(fmt("Updating the standard library within {}.x: v{} -> v{}", int_to_str(sh2), std_have, std_in_major));
                        check rune_sync_std(std_in_major) != 0 { exit(1); }
                    }
                }
            } fallback {
                check rune_ver_ge(std_have, std_latest) == 0 {
                    echo!(fmt("Updating the standard library: v{} -> v{}", std_have, std_latest));
                    check rune_sync_std(std_latest) != 0 { exit(1); }
                }
            }
        }
    }

    // v1.5.0: when a new MAJOR exists, a bare update is capped to the newest release
    // within the installed major (never auto-jumps majors). Set inside the gate below.
    set major_cap: str = "";

    // For a bare `rune update`, check torvc AND rune independently (each from its
    // own repo). If both are current, stop. If only rune is behind, update just
    // the package manager from the rune repo. If torvc is behind, fall through to
    // the Torvik installer - which, under option B, also refreshes rune to latest,
    // so that single path covers "torvc only" and "both".
    check pinned == 0 {
        fixed latest: str = rune_fetch_latest_version();
        fixed latest_rune: str = rune_fetch_latest_rune();
        fixed inst_rune: str = rune_self_version();
        set tv_out: i64 = 0;
        check len(latest) > 0 && rune_ver_ge(installed, latest) == 0 { tv_out = 1; }
        set rune_out: i64 = 0;
        check len(latest_rune) > 0 && rune_ver_ge(inst_rune, latest_rune) == 0 { rune_out = 1; }

        // Everything current: nothing to do (unless forced).
        check tv_out == 0 && rune_out == 0 && forced == 0 {
            echo!(fmt("You're already on the latest Torvik (v{}) and rune (v{}).", installed, inst_rune));
            echo!("  Nothing to update. Use 'rune update --force' to reinstall the toolchain,");
            echo!("  or 'rune update vX.Y.Z' to install a specific Torvik version.");
            exit(0);
        }

        // rune-only update: the toolchain is current, just the manager moved.
        check tv_out == 0 && rune_out == 1 && forced == 0 {
            check confirmed == 0 {
                echo!(fmt("A new rune is available: v{} (you have v{}). Torvik itself is current.", latest_rune, inst_rune));
                echo!("This updates just the package manager, from the torvik-lang/rune repo.");
                echo!("Re-run to confirm:  rune update --yes");
                exit(0);
            }
            echo!(fmt("Updating rune to v{}...", latest_rune));
            fixed rrc: i64 = rune_run_rune_installer();
            check rrc == 0 { echo!("Done. Run 'rune version' to confirm."); exit(0); }
            echo!("rune update failed. See https://github.com/torvik-lang/rune/releases");
            exit(rrc);
        }

        // torvc update available. If a NEW MAJOR is out, never auto-install it:
        // cap the update to the newest release within the installed major and
        // surface the new major (silence-aware). Same-major updates proceed normally.
        check tv_out == 1 {
            fixed inst_major: i64 = rune_ver_part(installed, 0);
            fixed latest_major: i64 = rune_ver_part(latest, 0);
            check latest_major > inst_major {
                fixed in_major: str = rune_fetch_latest_in_major(inst_major);
                check rune_has_silence_major() == 1 {
                    check rune_notice_get("torvik_major") >= latest_major {
                        echo!(fmt("Torvik v{} was already silenced. You'll hear about the next major, not this one.", latest));
                    } fallback {
                        rune_notice_set("torvik_major", latest_major);
                        echo!(fmt("Silenced: no more notices about Torvik v{}.", latest));
                        echo!(fmt("  You'll be told again when {}.0.0 ships.", int_to_str(latest_major + 1)));
                    }
                } fallback {
                    check rune_notice_get("torvik_major") < latest_major {
                        echo!(fmt("Heads up: Torvik v{} is available - a NEW MAJOR (you're on v{}).", latest, installed));
                        echo!("  Major versions may include breaking changes, so rune is keeping you on your");
                        echo!(fmt("  current major ({}.x) and will still pull its newest patches.", int_to_str(inst_major)));
                        echo!(fmt("  When ready:  rune update v{} --yes    (review the changelog first)", int_to_str(latest_major)));
                        echo!("  Silence this notice:  rune update --silence-major");
                    }
                }
                // Already newest within our major? Nothing to install (unless forced).
                check len(in_major) == 0 || rune_ver_ge(installed, in_major) == 1 {
                    check forced == 0 {
                        echo!(fmt("You're on the latest {}.x (v{}). Nothing to update.", int_to_str(inst_major), installed));
                        exit(0);
                    }
                } fallback {
                    major_cap = in_major;
                }
            }
        }
    }

    // Effective install target: an explicit pin, else the major cap (newest in the
    // installed major when a new major is being held back), else plain "latest".
    set eff_pinned: i64 = pinned;
    set eff_target: str = "latest";
    check pinned == 1 { eff_target = rune_version_canon(pin); }
    check len(major_cap) > 0 { eff_pinned = 1; eff_target = major_cap; }
    check confirmed == 0 {
        check eff_pinned == 1 {
            echo!(fmt("This installs Torvik {} (torvc, rune, and the standard library),", eff_target));
            echo!("replacing your current toolchain. Your projects are not touched.");
            check len(major_cap) > 0 {
                echo!("Re-run to confirm:  rune update --yes");
            } fallback {
                echo!(fmt("Re-run to confirm:  rune update {} --yes", pin));
            }
        } fallback {
            echo!("This updates the Torvik toolchain (torvc, rune, and the standard library)");
            echo!("to the latest release by re-running the official installer.");
            echo!("Your projects are not touched.");
            echo!("Re-run to confirm:  rune update --yes");
        }
        exit(0);
    }
    check eff_pinned == 1 {
        echo!(fmt("Installing Torvik {}...", eff_target));
    } fallback {
        echo!("Updating the Torvik toolchain to the latest release...");
    }
    // The pinned version is handed to the installer through TORVIK_VERSION; the
    // installer resolves partial versions (v1, v1.0) against the GitHub release
    // list and errors cleanly if the release doesn't exist.
    check win == 1 {
        set setver: str = "";
        check eff_pinned == 1 { setver = str_concat(str_concat("$env:TORVIK_VERSION='", eff_target), "'; "); }
        // Fetch the installer into a variable first (inside try/catch) so a rate
        // limit (HTTP 429) or network error on the fetch itself surfaces as a
        // clean message instead of a raw PowerShell exception dump. Only run the
        // script if the fetch succeeded. Inner strings use single quotes to avoid
        // nested double-quote escaping inside -Command.
        fixed guarded: str = str_concat(setver, "try { $s = (iwr -useb 'https://raw.githubusercontent.com/torvik-lang/torvik/main/windows/install.ps1').Content } catch { if ($_.Exception.Response.StatusCode.value__ -eq 429) { Write-Host 'error: GitHub is rate-limiting downloads right now (HTTP 429 Too Many Requests).' -ForegroundColor Red; Write-Host '  This is temporary - wait a few minutes and run rune update again.' -ForegroundColor Red } else { Write-Host 'error: could not download the installer (network or GitHub error). Try again shortly.' -ForegroundColor Red }; exit 1 }; Invoke-Expression $s");
        fixed pscmd: str = str_concat(str_concat("powershell -NoProfile -ExecutionPolicy Bypass -Command \"", guarded), "\"");
        set rc: i64 = sys_run(pscmd);
        check rc == 0 { echo!("Done. Run 'torvc version' to confirm."); exit(0); }
        echo!("Install failed. If you pinned a version, check it exists at");
        echo!("  https://github.com/torvik-lang/torvik/releases");
        exit(rc);
    }
    // POSIX: set TORVIK_VERSION inline before the piped installer when pinning.
    set setver: str = "";
    check eff_pinned == 1 { setver = str_concat(str_concat("TORVIK_VERSION=", eff_target), " "); }
    set rc: i64 = 1;
    fixed lurl: str = "https://raw.githubusercontent.com/torvik-lang/torvik/main/linux/install.sh";
    check rune_on_path("curl") == 1 {
        // Probe the HTTP status first so a rate limit (429) or other HTTP error
        // gives a clean, specific message instead of a silent failure.
        fixed probe_tmp: str = str_concat(sys_home_dir(), "/.torvik/.httpcode");
        // v1.3.0: plain string literals no longer collapse {{ to { (interpolation
        // is scoped to echo/echo!/fmt), so curl's %{http_code} format is built
        // from char-literal braces - identical output under old and new semantics.
        fixed curl_fmt: str = str_concat("sh -c 'curl -s -o /dev/null -w \"%", '{', "http_code", '}', "\" ");
        sys_run(str_concat(str_concat(curl_fmt, lurl), str_concat(" > ", str_concat(probe_tmp, " 2>/dev/null'"))));
        set http: str = "";
        check fs_exists(probe_tmp) == 1 { http = trim(readfile(probe_tmp)); }
        sys_run(str_concat("rm -f ", probe_tmp));
        check http == "429" {
            echo!("error: GitHub is rate-limiting downloads right now (HTTP 429 Too Many Requests).");
            echo!("  This is temporary - wait a few minutes and run rune update again.");
            exit(1);
        }
        rc = sys_run(str_concat(setver, str_concat(str_concat("sh -c 'curl -fsSL ", lurl), " | sh'")));
    } fallback {
        check rune_on_path("wget") == 1 {
            rc = sys_run(str_concat(setver, str_concat(str_concat("sh -c 'wget -qO- ", lurl), " | sh'")));
        } fallback {
            echo!("rune update needs curl or wget to fetch the installer. Install one and retry,");
            echo!("or re-run the install command from the Torvik README.");
            exit(1);
        }
    }
    check rc == 0 { echo!("Done. Run 'torvc version' to confirm."); exit(0); }
    echo!("Install failed. If you pinned a version, check it exists at");
    echo!("  https://github.com/torvik-lang/torvik/releases");
    exit(rc);
}

// `rune self-update` - update ONLY the package manager, from the rune repo. The
// smart `rune update` already does this when torvc is current; this is the
// explicit form (and honours --force to reinstall the same version).
df rune_cmd_self_update(confirmed: i64) -> void {
    fixed latest: str = rune_fetch_latest_rune();
    fixed inst: str = rune_self_version();
    check len(latest) == 0 {
        echo!("Couldn't reach the rune repo to check for updates (network or GitHub error).");
        echo!("  Try again shortly, or see https://github.com/torvik-lang/rune/releases");
        exit(1);
    }
    check rune_ver_ge(inst, latest) == 1 && rune_has_force() == 0 {
        echo!(fmt("rune is already up to date (v{}).", inst));
        echo!("  Use 'rune self-update --force' to reinstall anyway.");
        exit(0);
    }
    check confirmed == 0 {
        echo!(fmt("This updates rune to v{} (you have v{}), from the torvik-lang/rune repo.", latest, inst));
        echo!("Torvik itself is not touched. Re-run to confirm:  rune self-update --yes");
        exit(0);
    }
    echo!(fmt("Updating rune to v{}...", latest));
    fixed rc: i64 = rune_run_rune_installer();
    check rc == 0 { echo!("Done. Run 'rune version' to confirm."); exit(0); }
    echo!("rune update failed. See https://github.com/torvik-lang/rune/releases");
    exit(rc);
}

df rune_cmd_uninstall(confirmed: i64) -> void {
    fixed root: str = str_concat(sys_home_dir(), "/.torvik");
    check rune_path_exists(root) == 0 {
        echo!(fmt("Torvik is not installed ({} not found).", rune_home_display()));
        exit(0);
    }
    check confirmed == 0 {
        echo!(fmt("This removes the Torvik toolchain at {} (torvc, rune, libs, config),", rune_home_display()));
        echo!("the Torvik PATH entry from your shell startup files, and the .tv file-type");
        echo!("and icon registration.");
        echo!("Re-run to confirm:  rune uninstall --yes");
        exit(0);
    }
    fs_remove(root);
    echo!(fmt("Removed {}.", rune_home_display()));
    rune_clean_path_entries();
    rune_deregister_icons();
    // v1.2.0: Windows locks a running program's file, so rune.exe cannot delete
    // itself the way the Linux uninstall removes rune - fs_remove above cleared
    // everything EXCEPT bin\rune.exe (and so bin\ remained). Schedule the final
    // sweep: a tiny batch in %TEMP% waits for this process to exit, removes
    // what's left of ~/.torvik, and deletes itself.
    check rune_str_eq(sys_os_name(), "windows") == 1 {
        fixed wtmp: str = readenv("TEMP");
        check len(wtmp) > 0 {
            fixed wroot: str = replace(root, "/", "\\");
            fixed wbat: str = str_concat(wtmp, "\\torvik_uninstall_sweep.bat");
            set wbs: str = "@echo off\r\n";
            wbs = str_concat(wbs, "ping -n 3 127.0.0.1 > NUL\r\n");
            wbs = str_concat(wbs, str_concat(str_concat("rd /s /q \"", wroot), "\"\r\n"));
            wbs = str_concat(wbs, "del \"%~f0\"\r\n");
            writefile(wbat, wbs);
            sys_run(str_concat(str_concat("start \"\" /min cmd /c \"", wbat), "\""));
            echo!("Torvik has been uninstalled. (rune.exe sweeps itself away in a moment -");
            echo!("Windows locks a running program, so the last file goes via a scheduled cleanup.)");
            return;
        }
        // No %TEMP% (unusual): say exactly what is left and how to finish.
        echo!("Torvik has been uninstalled, except rune.exe itself - Windows locks a");
        echo!(fmt("running program. Delete the leftover folder by hand: {}", rune_home_display()));
        return;
    }
    echo!("Torvik has been uninstalled.");
}

// ─── Version / config (read) ────────────────────────────────────────────────

df rune_version_content() -> str {
    // Prefer a local VERSION only if it is actually a Torvik VERSION (has a `torvik`
    // field) - so running from the Torvik repo still reports the checkout's version,
    // but a project that happens to keep its own VERSION file (very common) doesn't
    // shadow the installed toolchain version and read as 0.0.0.
    check rune_path_exists("VERSION") == 1 {
        fixed local: str = readfile("VERSION");
        check len(rune_field(local, "torvik")) > 0 { return local; }
    }
    fixed inst: str = str_concat(sys_home_dir(), "/.torvik/lib/VERSION");
    check rune_path_exists(inst) == 1 { return readfile(inst); }
    return "";
}

df rune_ver_of(key: str) -> str {
    fixed v: str = rune_field(rune_version_content(), key);
    check len(v) > 0 { return v; }
    return "0.0.0";
}

// rune's OWN version, independent of Torvik. rune is versioned and released from
// its own repo now, so its number no longer lives in Torvik's VERSION. Prefer a
// local VERSION (running from a rune checkout), then the installed
// ~/.torvik/rune.VERSION written by the installer / rune_make, then a build-time
// fallback. Kept out of Torvik's VERSION so a torvc update can't wipe it.
df rune_self_version() -> str {
    check rune_path_exists("VERSION") == 1 {
        fixed lv: str = rune_field(readfile("VERSION"), "rune");
        check len(lv) > 0 { return lv; }
    }
    fixed rf: str = str_concat(sys_home_dir(), "/.torvik/rune.VERSION");
    check rune_path_exists(rf) == 1 {
        fixed iv: str = rune_field(readfile(rf), "rune");
        check len(iv) > 0 { return iv; }
    }
    // Last resort, only reached if neither a local nor an installed VERSION is
    // readable. MUST be bumped with every release - it is the one version number
    // in the tree that no file can correct.
    return "1.5.0";
}

// Parse the Nth dotted component of a version string as an integer (missing
// components read as 0, so "1.1" has patch 0). Ignores a leading 'v'.
df rune_ver_part(v: str, idx: i64) -> i64 {
    set s: str = v;
    check starts(s, "v") || starts(s, "V") { s = substr(s, 1, len(s)); }
    fixed n: i64 = len(s);
    set part: i64 = 0;
    set cur: i64 = 0;
    set i: i64 = 0;
    whilst i < n {
        fixed c: i64 = byte_at(s, i);
        check c == 46 {
            check part == idx { return cur; }
            part += 1; cur = 0;
        } fallback {
            check c >= 48 && c <= 57 { cur = cur * 10 + (c - 48); }
        }
        i += 1;
    }
    check part == idx { return cur; }
    return 0;
}

// Compare two versions: returns 1 if a >= b, else 0. Compares major, then minor,
// then patch. Used to check whether the installed toolchain meets a project's
// minimum-version requirement.
df rune_ver_ge(a: str, b: str) -> i64 {
    fixed a0: i64 = rune_ver_part(a, 0); fixed b0: i64 = rune_ver_part(b, 0);
    check a0 > b0 { return 1; } check a0 < b0 { return 0; }
    fixed a1: i64 = rune_ver_part(a, 1); fixed b1: i64 = rune_ver_part(b, 1);
    check a1 > b1 { return 1; } check a1 < b1 { return 0; }
    fixed a2: i64 = rune_ver_part(a, 2); fixed b2: i64 = rune_ver_part(b, 2);
    check a2 >= b2 { return 1; }
    return 0;
}

// ─── v1.5.0: major-version gating support ────────────────────────────────────
df rune_is_digit(c: i64) -> i64 { check c >= 48 && c <= 57 { return 1; } return 0; }

// Parse a bare "X.Y.Z" semver starting at `start`; returns it, or "" if the text
// at that position is not a full three-part version.
df rune_parse_semver_at(text: str, start: i64) -> str {
    fixed n: i64 = len(text);
    set i: i64 = start;
    set a: str = "";
    whilst i < n && rune_is_digit(byte_at(text, i)) == 1 { a = str_concat(a, substr(text, i, i + 1)); i += 1; }
    check len(a) == 0 { return ""; }
    check i >= n || byte_at(text, i) != 46 { return ""; }
    i += 1;
    set b: str = "";
    whilst i < n && rune_is_digit(byte_at(text, i)) == 1 { b = str_concat(b, substr(text, i, i + 1)); i += 1; }
    check len(b) == 0 { return ""; }
    check i >= n || byte_at(text, i) != 46 { return ""; }
    i += 1;
    set c: str = "";
    whilst i < n && rune_is_digit(byte_at(text, i)) == 1 { c = str_concat(c, substr(text, i, i + 1)); i += 1; }
    check len(c) == 0 { return ""; }
    return str_concat(a, str_concat(".", str_concat(b, str_concat(".", c))));
}

// Scan release/tag JSON for the newest vX.Y.Z whose major == `major`. Anchors on
// 'v' followed by a version so URL noise (zipball URLs carry the same tags) can't
// pick a wrong value - duplicates only reinforce the same max.
df rune_latest_tag_in_major(text: str, major: i64) -> str {
    set best: str = "";
    fixed n: i64 = len(text);
    set i: i64 = 0;
    whilst i < n {
        check byte_at(text, i) == 118 {
            fixed parsed: str = rune_parse_semver_at(text, i + 1);
            check len(parsed) > 0 {
                check rune_ver_part(parsed, 0) == major {
                    check len(best) == 0 || rune_ver_ge(parsed, best) == 1 { best = parsed; }
                }
            }
        }
        i += 1;
    }
    return best;
}

// Fetch a URL's raw contents into the cache dir; "" on any failure.
df rune_fetch_to_cache(url: str, tmpname: str) -> str {
    fixed cache: str = str_concat(sys_home_dir(), "/.torvik/cache");
    rune_mkdir(cache);
    fixed tmp: str = str_concat(cache, str_concat("/", tmpname));
    set rc: i64 = 1;
    check rune_str_eq(sys_os_name(), "windows") == 1 {
        fixed ps: str = str_concat(str_concat("powershell -NoProfile -Command \"(iwr -useb ", url), str_concat(").Content | Out-File -Encoding ascii '", str_concat(tmp, "'\"")));
        rc = sys_run(ps);
    } fallback {
        check rune_on_path("curl") == 1 {
            rc = sys_run(str_concat(str_concat("curl -fsSL ", url), str_concat(" -o ", tmp)));
        } fallback {
            check rune_on_path("wget") == 1 { rc = sys_run(str_concat(str_concat("wget -qO ", tmp), str_concat(" ", url))); }
        }
    }
    check rc != 0 { return ""; }
    check fs_exists(tmp) == 0 { return ""; }
    return readfile(tmp);
}

// The newest published Torvik release within a given major, via the GitHub tags
// API. "" if unreachable or none found. Called only when a NEW major is detected,
// so it adds no request on the common same-major update path.
df rune_fetch_latest_in_major(major: i64) -> str {
    fixed body: str = rune_fetch_to_cache("https://api.github.com/repos/torvik-lang/torvik/tags", "torvik_tags.json");
    check len(body) == 0 { return ""; }
    return rune_latest_tag_in_major(body, major);
}

// ── Silence state (~/.torvik/notices.rune): highest acknowledged major per key ──
df rune_notices_path() -> str { return str_concat(sys_home_dir(), "/.torvik/notices.rune"); }

df rune_notice_get(key: str) -> i64 {
    fixed p: str = rune_notices_path();
    check rune_path_exists(p) == 1 {
        fixed v: str = rune_field(readfile(p), key);
        check len(v) > 0 { return rune_ver_part(v, 0); }
    }
    return 0;
}

df rune_notice_set(key: str, major: i64) -> void {
    set tv_m: i64 = rune_notice_get("torvik_major");
    set std_m: i64 = rune_notice_get("std_major");
    check rune_str_eq(key, "torvik_major") == 1 { tv_m = major; }
    check rune_str_eq(key, "std_major") == 1 { std_m = major; }
    set body: str = "# notices.rune - acknowledged major-version notices (managed by rune).\n";
    body = str_concat(body, str_concat("torvik_major = ", str_concat(int_to_str(tv_m), "\n")));
    body = str_concat(body, str_concat("std_major = ", str_concat(int_to_str(std_m), "\n")));
    writefile(rune_notices_path(), body);
}

// If the project's manifest declares a minimum Torvik version (`torvik = "1.1.0"`
// in torvik.rune), verify the installed toolchain meets it. A too-old toolchain
// is a clean error telling the user exactly what to run. A malformed version in
// the manifest is also reported. No manifest / no field: nothing to check.
df rune_check_project_version() -> void {
    check rune_path_exists("torvik.rune") == 0 { return; }
    fixed req: str = rune_field(readfile("torvik.rune"), "torvik");
    check len(req) == 0 { return; }
    check rune_version_syntax_ok(req) == 0 {
        echo!(fmt("error: torvik.rune has an invalid 'torvik' version requirement: '{}'.", req));
        echo!("  Use a version like  torvik = \"1.1.0\"");
        exit(1);
    }
    fixed have: str = rune_ver_of("torvik");
    check rune_ver_ge(have, req) == 0 {
        echo!(fmt("error: this project requires Torvik {} or newer, but v{} is installed.", req, have));
        echo!(fmt("  Update with:  rune update v{}", req));
        exit(1);
    }
}

// v1.2.0: the standard library is versioned independently of the compiler (the
// `std` line in VERSION). A project can declare `std = "1.1.0"` in torvik.rune
// to require a minimum standard-library version - useful when std has grown or
// made a breaking change without a corresponding compiler bump. std ships with
// the toolchain, so the fix is always `rune update`.
// ── v1.5.0: the standard library is its own repository ───────────────────────
// std used to ship inside the Torvik repo and was pinned to the compiler's git ref,
// which made it impossible to version the two separately. It now lives at
// github.com/torvik-lang/std and carries its own semver, so a project can hold std
// on one major while the toolchain moves on.
df rune_std_repo_raw(ref: str) -> str {
    return str_concat(str_concat("https://raw.githubusercontent.com/torvik-lang/std/", ref), "/src/");
}

// The installed std version. Written by the installers to lib/std.VERSION; older
// toolchains recorded it in Torvik's own VERSION, so fall back to that.
df rune_std_installed() -> str {
    fixed p: str = str_concat(sys_home_dir(), "/.torvik/lib/std.VERSION");
    check rune_path_exists(p) == 1 {
        fixed v: str = rune_field(readfile(p), "std");
        check len(v) > 0 { return v; }
    }
    return rune_ver_of("std");
}

// Newest published std, or "" if unreachable.
df rune_fetch_latest_std() -> str {
    fixed body: str = rune_fetch_to_cache("https://raw.githubusercontent.com/torvik-lang/std/main/VERSION", "std_latest.txt");
    check len(body) == 0 { return ""; }
    return rune_field(body, "std");
}

// Newest std within a given major, via the tags API. Only called when a NEW major
// exists, so the common path costs no extra request.
df rune_fetch_latest_std_in_major(major: i64) -> str {
    fixed body: str = rune_fetch_to_cache("https://api.github.com/repos/torvik-lang/std/tags", "std_tags.json");
    check len(body) == 0 { return ""; }
    return rune_latest_tag_in_major(body, major);
}

// Install a specific std version into the toolchain's lib directory. The module list
// is DERIVED from std.tv rather than hardcoded - a hardcoded list silently skipped
// std::convert when it was added in v1.2.0, and this is the same lesson.
df rune_sync_std(ver: str) -> i64 {
    fixed base: str = rune_std_repo_raw(str_concat("v", ver));
    fixed libdir: str = str_concat(sys_home_dir(), "/.torvik/lib");
    rune_mkdir(libdir);
    rune_mkdir(str_concat(libdir, "/std"));

    fixed umbrella: str = rune_fetch_to_cache(str_concat(base, "std.tv"), "std_umbrella.tv");
    check len(umbrella) == 0 {
        echo!(fmt("rune: could not fetch standard library v{} (is that version published?).", ver));
        return 1;
    }
    writefile(str_concat(libdir, "/std.tv"), umbrella);

    // Every `apply std::NAME;` line in the umbrella names a module to install.
    set count: i64 = 0;
    set buf: str = "";
    set i: i64 = 0;
    whilst i <= len(umbrella) {
        set at_end: i64 = 0;
        check i == len(umbrella) { at_end = 1; }
        set c: i64 = 10;
        check at_end == 0 { c = byte_at(umbrella, i); }
        check c == 10 {
            check starts(buf, "apply std::") {
                set nm: str = "";
                set j: i64 = 11;
                whilst j < len(buf) {
                    fixed ch: i64 = byte_at(buf, j);
                    check (ch >= 97 && ch <= 122) || ch == 95 { nm = str_concat(nm, substr(buf, j, j + 1)); } fallback { j = len(buf); }
                    j += 1;
                }
                check len(nm) > 0 {
                    fixed mod: str = rune_fetch_to_cache(str_concat(str_concat(base, nm), ".tv"), str_concat(str_concat("std_", nm), ".tv"));
                    check len(mod) == 0 {
                        echo!(fmt("rune: standard library v{} lists module '{}' but it could not be fetched.", ver, nm));
                        return 1;
                    }
                    writefile(str_concat(str_concat(libdir, "/std/"), str_concat(nm, ".tv")), mod);
                    count += 1;
                }
            }
            buf = "";
        } fallback { buf = str_concat(buf, substr(umbrella, i, i + 1)); }
        i += 1;
    }
    writefile(str_concat(libdir, "/std.VERSION"), str_concat(str_concat("std = ", ver), "\n"));
    echo!(fmt("Standard library v{} installed ({} modules).", ver, int_to_str(count)));
    return 0;
}

// Record a chosen std version in the project manifest, so the project and the
// toolchain agree from here on. The manifest is the single source of truth.
df rune_manifest_set_std(ver: str) -> void {
    check rune_path_exists("torvik.rune") == 0 { return; }
    fixed content: str = readfile("torvik.rune");
    set out: str = "";
    set buf: str = "";
    set replaced: i64 = 0;
    set i: i64 = 0;
    whilst i <= len(content) {
        set at_end: i64 = 0;
        check i == len(content) { at_end = 1; }
        set c: i64 = 10;
        check at_end == 0 { c = byte_at(content, i); }
        check c == 10 {
            check starts(buf, "std ") || starts(buf, "std=") {
                out = str_concat(out, str_concat(str_concat("std = ", ver), "\n"));
                replaced = 1;
            } fallback {
                check at_end == 0 || len(buf) > 0 { out = str_concat(out, str_concat(buf, "\n")); }
            }
            buf = "";
        } fallback { buf = str_concat(buf, substr(content, i, i + 1)); }
        i += 1;
    }
    check replaced == 0 { out = str_concat(out, str_concat(str_concat("std = ", ver), "\n")); }
    writefile("torvik.rune", out);
    echo!(fmt("torvik.rune updated: std = {}", ver));
}

df rune_check_std_version() -> void {
    check rune_path_exists("torvik.rune") == 0 { return; }
    fixed req: str = rune_field(readfile("torvik.rune"), "std");
    check len(req) == 0 { return; }
    check rune_version_syntax_ok(req) == 0 {
        echo!(fmt("error: torvik.rune has an invalid 'std' version requirement: '{}'.", req));
        echo!("  Use a version like  std = \"1.1.0\"");
        exit(1);
    }
    // v1.5.0: std records its own version in lib/std.VERSION.
    fixed have: str = rune_std_installed();
    check rune_ver_ge(have, req) == 0 {
        echo!(fmt("error: this project requires standard library {} or newer, but v{} is installed.", req, have));
        echo!("  Update it with:  rune update");
        echo!("  If that version is a new MAJOR, opt in with:  rune update --std-major --yes");
        exit(1);
    }
}

df rune_version() -> void {
    echo!(str_concat("rune v", str_concat(rune_self_version(), " - Torvik Package Manager")));
    echo!(str_concat("torvik v", rune_ver_of("torvik")));
    // std has its own version line as of v1.5.0; read it from lib/std.VERSION.
    fixed sv: str = rune_std_installed();
    check rune_str_eq(sv, "0.0.0") == 1 {
        echo!("std  not installed (run 'rune update' to fetch it)");
    } fallback {
        echo!(str_concat("std v", sv));
    }
}

df rune_config_get(key: str) -> str {
    fixed cp: str = str_concat(sys_home_dir(), "/.torvik/config.rune");
    check rune_path_exists(cp) == 1 { return rune_field(readfile(cp), key); }
    return "";
}

df rune_cmd_config() -> void {
    echo!("Rune config (~/.torvik/config.rune):");
    echo!(str_concat("  optimize = ", rune_config_get("optimize")));
    echo!(str_concat("  cache    = ", rune_config_get("cache")));
    echo!(str_concat("  registry = ", rune_config_get("url")));
}

// ─── Developer commands (unlisted in `rune help`) ───────────────────────────

df rune_config_path() -> str {
    return str_concat(sys_home_dir(), "/.torvik/config.rune");
}

df rune_known_key(k: str) -> i64 {
    check rune_str_eq(k, "optimize") == 1 { return 1; }
    check rune_str_eq(k, "cache") == 1 { return 1; }
    check rune_str_eq(k, "registry") == 1 { return 1; }
    check rune_str_eq(k, "diagnostics") == 1 { return 1; }
    return 0;
}

df rune_cfg_or(key: str, dflt: str) -> str {
    fixed v: str = rune_config_get(key);
    check len(v) > 0 { return v; }
    return dflt;
}

// Render the whole config file from three values - single source of file format.
df rune_render_config(optimize: str, cache: str, registry: str, diagnostics: str) -> str {
    set m: str = "# config.rune - Rune package manager settings (managed by Rune; not a project file).\n";
    m = str_concat(m, "# 'cache' is live: it governs incremental rebuilds.\n");
    m = str_concat(m, "# 'diagnostics' is live: it governs the internal diagnostics log (see 'rune dev status').\n");
    m = str_concat(m, "# 'optimize' and 'registry' are reserved for the Rune Library release.\n");
    m = str_concat(m, "[settings]\noptimize = \"");
    m = str_concat(m, optimize);
    m = str_concat(m, "\"\ncache    = \"");
    m = str_concat(m, cache);
    m = str_concat(m, "\"\ndiagnostics = \"");
    m = str_concat(m, diagnostics);
    m = str_concat(m, "\"\n\n[registry]\nurl = \"");
    m = str_concat(m, registry);
    m = str_concat(m, "\"\n");
    return m;
}

df rune_cmd_config_get(key: str) -> void {
    check rune_known_key(key) == 0 {
        echo!(str_concat(str_concat("rune: unknown config key '", key), "' (known: optimize, cache, registry)"));
        exit(1);
    }
    echo!(rune_config_get(key));
}

// Rewrites config.rune entirely via writefile - no shell, no quoting.
df rune_cmd_config_set(key: str, value: str) -> void {
    check rune_known_key(key) == 0 {
        echo!(str_concat(str_concat("rune: unknown config key '", key), "' (known: optimize, cache, registry)"));
        exit(1);
    }
    check rune_path_exists(rune_config_path()) == 0 {
        echo!("rune: config.rune not found; is Torvik installed?");
        exit(1);
    }
    set o: str = rune_cfg_or("optimize", "false");
    set c: str = rune_cfg_or("cache", "true");
    set u: str = rune_cfg_or("url", "https://runes.torvik-lang.dev");
    set d: str = rune_cfg_or("diagnostics", "true");
    check rune_str_eq(key, "optimize") == 1 { o = value; }
    check rune_str_eq(key, "cache") == 1 { c = value; }
    check rune_str_eq(key, "registry") == 1 { u = value; }
    check rune_str_eq(key, "diagnostics") == 1 { d = value; }
    writefile(rune_config_path(), rune_render_config(o, c, u, d));
    echo!(str_concat(str_concat("set ", key), str_concat(" = ", value)));
    check rune_str_eq(key, "cache") == 0 {
        check rune_str_eq(key, "diagnostics") == 0 {
            echo!("  (note: only 'cache' is live today; this key is reserved for the Rune Library release)");
        }
    }
}

// Cross-platform "is COMMAND on PATH?" - returns 1 if found. Uses `where` on
// Windows (cmd.exe builtin) and `command -v` on POSIX shells, silencing output.
df rune_on_path(cmd: str) -> i64 {
    check rune_str_eq(sys_os_name(), "windows") == 1 {
        check sys_run(fmt("where {} > NUL 2>&1", cmd)) == 0 { return 1; }
        return 0;
    }
    check sys_run(fmt("command -v {} > /dev/null 2>&1", cmd)) == 0 { return 1; }
    return 0;
}

df rune_doctor() -> void {
    fixed root: str = str_concat(sys_home_dir(), "/.torvik");
    echo!("Torvik doctor:");
    check rune_path_exists(str_concat(root, "/bin/torvc")) == 1 {
        echo!("  [ok]   torvc present (~/.torvik/bin/torvc)");
    } fallback {
        echo!("  [MISS] torvc not found in ~/.torvik/bin");
    }
    check rune_path_exists(str_concat(root, "/bin/rune")) == 1 {
        echo!("  [ok]   rune present (~/.torvik/bin/rune)");
    } fallback {
        echo!("  [MISS] rune not found in ~/.torvik/bin");
    }
    check rune_path_exists(str_concat(root, "/lib/torvik_codegen.tv")) == 1 {
        echo!("  [ok]   compiler library present (~/.torvik/lib)");
    } fallback {
        echo!("  [MISS] compiler library missing in ~/.torvik/lib");
    }
    check rune_path_exists(str_concat(root, "/lib/VERSION")) == 1 {
        echo!("  [ok]   VERSION present");
    } fallback {
        echo!("  [MISS] VERSION missing in ~/.torvik/lib");
    }
    check rune_path_exists(rune_config_path()) == 1 {
        echo!("  [ok]   config.rune present");
    } fallback {
        echo!("  [MISS] config.rune missing");
    }
    check rune_on_path("clang") == 1 {
        echo!("  [ok]   clang found on PATH");
    } fallback {
        echo!("  [MISS] clang not on PATH (required to link builds)");
    }
    check rune_on_path("torvc") == 1 {
        echo!("  [ok]   torvc on PATH");
    } fallback {
        echo!("  [warn] torvc not on PATH (add ~/.torvik/bin to PATH)");
    }
}

df rune_dev_log_tail(content: str, n: i64) -> void {
    check len(content) == 0 { echo!("diagnostics log is empty"); return; }
    fixed raw: list<str> = split(content, "\n");
    set lines: list<str> = list_new();
    set r: i64 = 0;
    whilst r < len(raw) {
        check len(raw[r]) > 0 { push(lines, raw[r]); }
        r += 1;
    }
    fixed total: i64 = len(lines);
    check total == 0 { echo!("diagnostics log is empty"); return; }
    set startidx: i64 = 0;
    check total > n { startidx = total - n; }
    set i: i64 = startidx;
    whilst i < total {
        echo!(lines[i]);
        i += 1;
    }
}

df rune_dev_log(argc: i64) -> void {
    check argc >= 4 {
        check rune_str_eq(args_get(3), "clear") == 1 { diag_log_clear(); echo!("diagnostics log cleared"); return; }
        check rune_str_eq(args_get(3), "tail") == 1 {
            check argc >= 5 { rune_dev_log_tail(diag_log_read(), toint(args_get(4))); return; }
            rune_dev_log_tail(diag_log_read(), 20);
            return;
        }
    }
    fixed content: str = diag_log_read();
    check len(content) == 0 { echo!("diagnostics log is empty"); return; }
    echo!(content);
}

df rune_dev_status() -> void {
    check diag_enabled() == 1 { echo!("diagnostics: ON"); } fallback { echo!("diagnostics: OFF"); }
    echo!(fmt("log file:   {}", diag_log_path()));
    echo!(fmt("entries:    {}", diag_count(diag_log_read())));
}

df rune_dev_help() -> void {
    echo!("rune - developer commands (maintainers only; unlisted in 'rune help')");
    echo!("");
    echo!("  rune config                 Show Rune's own settings (~/.torvik/config.rune)");
    echo!("  rune dev config get <key>   Print one config value");
    echo!("  rune dev config set <k> <v> Update a config value (optimize|cache|registry)");
    echo!("  rune dev log                Show the internal diagnostics log");
    echo!("  rune dev log tail <n>       Show the last n diagnostics entries");
    echo!("  rune dev log clear          Clear the diagnostics log");
    echo!("  rune dev diagnostics on|off Enable/disable internal diagnostics logging");
    echo!("  rune dev status             Show diagnostics state + log stats");
    echo!("  rune doctor                 Check toolchain health");
    echo!("  rune version                Show component versions");
    echo!("  rune dev                    Show this menu");
    echo!("");
    echo!("These act on the Torvik toolchain itself, not on a user project.");
}

df rune_help() -> void {
    echo!("rune - Torvik Package Manager");
    echo!("");
    echo!("USAGE:");
    echo!("  rune new <name>     Create a new project in a new directory");
    echo!("  rune init [name]    Create a project in the current directory");
    echo!("  rune build          Compile the project to build/<name>");
    echo!("  rune run            Compile and run (incremental)");
    echo!("  rune list           Show project info  (alias: ls)");
    echo!("  rune clean          Remove the build/ directory");
    echo!("  rune update [vX]    Update Torvik (torvc + std) and rune to the latest, or pin torvc to vX");
    echo!("  rune self-update    Update just rune (the package manager) from its own repo");
    echo!(fmt("  rune uninstall      Remove the Torvik toolchain and rune ({})", rune_home_display()));
    echo!("  rune version        Show versions");
    echo!("  rune help           Show this help");
    echo!("");
    echo!("FLAGS:");
    echo!("  --final             Production build (-O3, stripped)");
    echo!("  --yes               Skip the confirmation prompt (update, uninstall)");
    echo!("  --force             Reinstall even if already on the latest version (update)");
    echo!("");
    echo!("  (add, remove: arrive with the Rune Library, a future version)");
}

// ─── Entry point ────────────────────────────────────────────────────────────

df main() -> void {
    // On Windows, `rune update` can't overwrite the running rune.exe, so the
    // installer renames the old one aside to rune.exe.old and swaps in the new
    // one. By the time rune runs again that old process is gone, so clean up any
    // leftover .old binaries here (silent, best-effort; POSIX has no such file).
    check sys_os_name() == "windows" {
        fixed bindir: str = str_concat(sys_home_dir(), "\\.torvik\\bin");
        sys_run(str_concat(str_concat("cmd /c del /q \"", bindir), "\\rune.exe.old\" >nul 2>&1"));
        sys_run(str_concat(str_concat("cmd /c del /q \"", bindir), "\\torvc.exe.old\" >nul 2>&1"));
    }

    fixed argc: i64 = args();
    check argc < 2 { rune_help(); exit(0); }
    fixed cmd: str = args_get(1);

    check cmd == "new" {
        check argc < 3 { echo!("error: usage: rune new <project-name>"); exit(1); }
        rune_cmd_new(args_get(2));
        exit(0);
    }
    check cmd == "init" {
        check argc < 3 { rune_cmd_init(rune_cwd_name()); exit(0); }
        rune_cmd_init(args_get(2));
        exit(0);
    }
    check cmd == "build"     { rune_cmd_build(rune_has_final()); exit(0); }
    check cmd == "run"       { rune_cmd_run(rune_has_final());   exit(0); }
    check cmd == "clean"     { rune_cmd_clean();                 exit(0); }
    check cmd == "list"      { rune_cmd_list();                  exit(0); }
    check cmd == "ls"        { rune_cmd_list();                  exit(0); }
    check cmd == "version"   { rune_version();                   exit(0); }
    check cmd == "--version" { rune_version();                   exit(0); }
    check cmd == "help"      { rune_help();                      exit(0); }
    check cmd == "--help"    { rune_help();                      exit(0); }
    check cmd == "uninstall" { rune_cmd_uninstall(rune_has_yes()); exit(0); }

    check cmd == "config"    { rune_cmd_config();                exit(0); }
    check cmd == "doctor"    { rune_doctor();                    exit(0); }
    check cmd == "dev" {
        check argc < 3 { rune_dev_help(); exit(0); }
        check rune_str_eq(args_get(2), "config") == 1 {
            check argc >= 5 {
                check rune_str_eq(args_get(3), "set") == 1 { rune_cmd_config_set(args_get(4), args_get(5)); exit(0); }
            }
            check argc >= 4 {
                check rune_str_eq(args_get(3), "get") == 1 { rune_cmd_config_get(args_get(4)); exit(0); }
            }
            echo!("usage: rune dev config get <key> | rune dev config set <key> <value>");
            exit(1);
        }
        check rune_str_eq(args_get(2), "log") == 1 { rune_dev_log(argc); exit(0); }
        check rune_str_eq(args_get(2), "status") == 1 { rune_dev_status(); exit(0); }
        check rune_str_eq(args_get(2), "diagnostics") == 1 {
            check argc >= 4 {
                check rune_str_eq(args_get(3), "on") == 1 { rune_cmd_config_set("diagnostics", "true"); echo!("diagnostics enabled"); exit(0); }
                check rune_str_eq(args_get(3), "off") == 1 { rune_cmd_config_set("diagnostics", "false"); echo!("diagnostics disabled"); exit(0); }
            }
            echo!("usage: rune dev diagnostics on|off");
            exit(1);
        }
        rune_dev_help();
        exit(0);
    }

    check cmd == "update"    { rune_cmd_update(rune_has_yes(), rune_update_version_arg());  exit(0); }
    check cmd == "self-update" { rune_cmd_self_update(rune_has_yes()); exit(0); }

    check cmd == "add" || cmd == "remove" || cmd == "rm" || cmd == "upgrade" || cmd == "pin" || cmd == "unpin" || cmd == "audit" {
        echo!(str_concat(str_concat("rune: '", cmd), "' needs the Rune Library, planned for a future release."));
        exit(1);
    }

    echo!(str_concat(str_concat("error: unknown rune command '", cmd), "'"));
    echo!("  run 'rune help' for usage.");
    exit(1);
}
